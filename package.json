{
  "name": "maintainer-hq",
  "version": "0.1.0",
  "private": true,
  "description": "An online operator workspace for repository fleets",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build",
    "docs:check": "npm --prefix site run check",
    "docs:test:browser": "playwright test --config playwright.docs.config.ts",
    "test": "vitest run && tsx --test test/*.node.ts",
    "release": "tsx cli/release.ts",
    "test:release": "tsx --test test/release/*.node.ts",
    "test:e2e": "npm run db:e2e:prepare && playwright test",
    "db:e2e:prepare": "wrangler d1 migrations apply HQ_DB --local --config wrangler.e2e.jsonc --persist-to \"${HQ_E2E_STATE:-.wrangler/state}\" && wrangler d1 execute HQ_DB --local --config wrangler.e2e.jsonc --persist-to \"${HQ_E2E_STATE:-.wrangler/state}\" --file fixtures/e2e-reset.sql && wrangler d1 execute HQ_DB --local --config wrangler.e2e.jsonc --persist-to \"${HQ_E2E_STATE:-.wrangler/state}\" --file fixtures/development.sql && wrangler d1 execute HQ_DB --local --config wrangler.e2e.jsonc --persist-to \"${HQ_E2E_STATE:-.wrangler/state}\" --file fixtures/e2e-members.sql",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply HQ_DB --local --config wrangler.dev.jsonc",
    "db:seed": "wrangler d1 execute HQ_DB --local --config wrangler.dev.jsonc --file fixtures/development.sql",
    "dev:prepare": "npm run db:migrate && npm run db:seed",
    "check:publication": "tsx scripts/check-publication.mjs",
    "check:dependencies": "tsx cli/dependencies.ts check",
    "dependencies:report": "tsx cli/dependencies.ts check --json",
    "check": "npm run check:dependencies && npm run typecheck && npm test && npm run build && npm run check:publication",
    "cli": "tsx cli/index.ts",
    "mcp": "tsx cli/mcp.ts",
    "capture:cover": "node scripts/capture-cover.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "commander": "15.0.0",
    "hono": "4.13.7",
    "jose": "6.2.12",
    "jsonc-parser": "3.3.1",
    "libsodium-wrappers": "0.8.4",
    "lucide-react": "^1.42.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "semver": "7.8.5",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.57.1",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.136.1"
  },
  "overrides": {
    "miniflare": {
      "sharp@0.35.2": "0.35.4"
    }
  }
}
