{
  "name": "maintainer-hq-development",
  "main": "worker/development.ts",
  "durable_objects": {
    "bindings": [
      { "name": "WORKSPACE_EVENTS", "class_name": "WorkspaceEvents" },
    ],
  },
  "migrations": [
    { "tag": "workspace-events-v1", "new_sqlite_classes": ["WorkspaceEvents"] },
  ],
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/healthz"],
  },
  "d1_databases": [
    {
      "binding": "HQ_DB",
      "database_name": "maintainer-hq-development",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations",
    },
  ],
}
