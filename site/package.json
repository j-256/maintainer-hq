    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "astro": "7.4.2",
    "parse5": "8.0.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss-nested": {
      "postcss-selector-parser@6.1.2": "7.1.6"
    }
  }
