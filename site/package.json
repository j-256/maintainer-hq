{
  "name": "hq-documentation",
  "version": "0.1.0",
  "private": true,
  "description": "Static product documentation for Maintainer HQ",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
